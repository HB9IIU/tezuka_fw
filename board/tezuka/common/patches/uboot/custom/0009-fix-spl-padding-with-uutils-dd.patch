From: Tezuka developers
Subject: [PATCH] spl: use binary padding compatible with uutils dd

conv=block requires cbs with uutils dd. GNU dd ignores block when cbs
is omitted, so only sync is needed to pad the binary to four bytes.
Keep diagnostics visible if padding fails.

--- a/scripts/Makefile.xpl
+++ b/scripts/Makefile.xpl
@@ -256,7 +256,7 @@
 endif
 
 $(obj)/$(SPL_BIN)-align.bin: $(obj)/$(SPL_BIN).bin
-	@dd if=$< of=$@ conv=block,sync bs=4 2>/dev/null;
+	@dd if=$< of=$@ conv=sync bs=4
 
 spl/boot.bin: $(obj)/$(SPL_BIN)-align.bin FORCE
 	$(call if_changed,mkimage)
